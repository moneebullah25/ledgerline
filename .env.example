# Required: compose refuses to start while this is empty (no default password).
POSTGRES_PASSWORD=
# SEC fair-access policy: identify yourself with a real contact address.
LEDGERLINE_SEC_USER_AGENT=Ledgerline research you@example.com
# Optional. Without it the LLM nodes run their deterministic offline implementations.
ANTHROPIC_API_KEY=
# Required for POST /v1/reports (sent as the X-API-Key header); unset disables report creation.
LEDGERLINE_API_KEY=
# Optional. JSON list of https hosts call audio may be downloaded from (pydantic-settings
# parses list fields as JSON), e.g. ["www.federalreserve.gov"]. Empty: local files only.
LEDGERLINE_AUDIO_HOSTS=[]
# Optional. "claude_cli" uses the local `claude` CLI session (no API key needed).
# Use "sdk" when ANTHROPIC_API_KEY is set and you want direct SDK calls.
LEDGERLINE_LLM_BACKEND=claude_cli
# Optional. Parallel workers used to verify claims per report. Increase for CPU/IO bound
# verification workloads; decrease to limit DB connection use.
# LEDGERLINE_VERIFY_WORKERS=4
# Optional. Log output format: json for prod (log aggregators), text for dev.
LEDGERLINE_LOG_FORMAT=json  # json (prod) or text (dev)
