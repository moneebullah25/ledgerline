# syntax=docker/dockerfile:1
# Worker image: same as the API build but with [ml] extras and CPU-only PyTorch wheels.
# The base Dockerfile installs torch from uv.lock (PyPI, CUDA-bundled ~3 GB).
# After uv sync, pip re-installs torch from the CPU-only index, shrinking the image
# from ~11.6 GB to ~3 GB. API image is unaffected.
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS build
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project --extra ml
COPY alembic.ini ./
COPY migrations ./migrations
COPY ledgerline ./ledgerline
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable --extra ml

# ponytail: CPU-only wheels; add CUDA extras if GPU inference is needed.
# Step 1: overwrite the CUDA torch/torchvision/torchaudio wheels with CPU-only variants.
# Step 2: remove nvidia-*, triton, and cuda-* packages that the CUDA torch dragged in as
#   separate dist-info packages — they are NOT dependencies of the CPU wheel so pip does not
#   remove them automatically, but they account for ~4 GB (nvidia 3.3 GB + triton 817 MB).
# Regenerating uv.lock with [tool.uv.sources] + UV_TORCH_BACKEND=cpu removes both steps.
RUN uv pip install --python /app/.venv --force-reinstall \
    --index-url https://download.pytorch.org/whl/cpu \
    torch torchvision torchaudio
RUN SP=/app/.venv/lib/python3.12/site-packages && \
    rm -rf "$SP/nvidia" "$SP/triton" "$SP/cuda" && \
    find "$SP" -maxdepth 1 -name 'nvidia_*.dist-info' -o -name 'triton-*.dist-info' \
               -o -name 'cuda_*.dist-info' | xargs rm -rf

FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg poppler-utils \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --system app && useradd --system --gid app --home-dir /app app
WORKDIR /app
COPY --from=build --chown=app:app /app /app
ENV PATH=/app/.venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    CUDA_VISIBLE_DEVICES="" \
    TORCH_DEVICE=cpu
USER app
CMD ["python", "-m", "ledgerline.worker"]
